<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>Bridge</AssemblyName><TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier><SelfContained>false</SelfContained>
    <DefineConstants>$(DefineConstants);LINUX_HOST</DefineConstants><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Bridge/IOperatorView.cs"/>
    <Compile Include="../Supervisor/*.cs"/>
    <Compile Include="../Bridge/Endpoint.cs;../Bridge/Worker.cs;../Bridge/Wire.cs;../Bridge/HostKeyPin.cs;../Bridge/SshSessions.cs;../Bridge/LimitedWrite.cs;../Bridge/DateSession.cs;../Bridge/Operation.cs;../Bridge/Audit.cs;../Bridge/History.cs"/>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.22"/>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0"/>
    <PackageReference Include="SSH.NET" Version="2026.0.1"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"/>
    <None Include="../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>

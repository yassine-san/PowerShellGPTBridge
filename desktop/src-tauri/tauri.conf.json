{
  "productName": "PowerShell Bridge",
  "version": "0.4.0",
  "identifier": "local.psbridge.supervisor",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "label": "manager",
        "title": "PowerShell Bridge • Operations",
        "width": 1180,
        "height": 780,
        "minWidth": 560,
        "minHeight": 440,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#101824"
      },
      {
        "label": "approval",
        "title": "PowerShell Bridge • Approval",
        "url": "index.html?window=approval",
        "width": 900,
        "height": 740,
        "decorations": false,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "backgroundColor": "#101824"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["supervisor"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
